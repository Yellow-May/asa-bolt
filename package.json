{
  "name": "asa-bolt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/main.ts",
    "dev:client": "vite",
    "dev:cloudflare": "wrangler dev --port 8810",
    "deploy:cloudflare": "wrangler deploy",
    "build": "tsc -b && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run --maxWorkers=5",
    "typecheck": "tsc -b --pretty false",
    "start": "node --env-file-if-exists=.env --import tsx server/main.ts",
    "db:backup": "node --env-file-if-exists=.env --import tsx scripts/database-backup.ts backup",
    "db:restore": "node --env-file-if-exists=.env --import tsx scripts/database-backup.ts restore"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "leaflet": "^1.9.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@eslint/js": "^9.33.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.156.0"
  }
}
